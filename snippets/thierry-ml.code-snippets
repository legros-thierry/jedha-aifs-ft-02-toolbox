    "body": [
      "def prophet_mape(p_df, split_date, regressors=()):",
      "    train_p = p_df.loc[p_df['ds'] < split_date, :]",
      "    test_p = p_df.loc[p_df['ds'] >= split_date, :]",
      "    m = Prophet()",
      "    for regressor in regressors:",
      "        m.add_regressor(regressor)",
      "    m.fit(train_p)",
      "    forecast = m.predict(test_p)",
      "    y_true, y_pred = test_p['y'].to_numpy(), forecast['yhat'].to_numpy()",
      "    return np.mean(np.abs((y_true - y_pred) / y_true)) * 100",
      "",
      "",
      "for split_date in [${2:'2020-03-11', '2020-04-11', '2020-05-11'}]:",
      "    mape = prophet_mape(${1:p_df}, split_date, regressors=[${3}])",
