      "${3:dataset}['Cluster_KMeans'] = kmeans.fit_predict(X_p)  # fit + numéro de groupe de chaque ligne",
      "print(f'Inertie : {kmeans.inertia_:.1f} | silhouette : {silhouette_score(X_p, kmeans.labels_):.3f}')",
      "display(${3:dataset}['Cluster_KMeans'].value_counts().sort_index())  # taille de chaque groupe",
      "# Les numéros de cluster n'ont aucun sens en eux-mêmes (0 n'est pas « plus petit » que 1)",
