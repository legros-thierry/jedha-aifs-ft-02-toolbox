  "KM · Comparer les clusters à de vraies étiquettes": {
    "scope": "python",
    "prefix": "ml-km-map",
    "description": "Seulement si on connaît les vraies classes (bac à sable). Le n° de cluster est arbitraire : on donne à chaque cluster sa classe majoritaire (mode), puis accuracy et tableau réel / prédit",
    "body": [
      "from scipy.stats import mode",
      "",
      "# ${1:clusters} = kmeans.fit_predict(...) ; ${2:target} = les vraies classes",
      "labels = np.zeros_like(${1:clusters})",
      "for i in np.unique(${1:clusters}):",
      "    mask = ${1:clusters} == i",
      "    labels[mask] = mode(${2:target}[mask])[0]  # classe la plus fréquente dans ce cluster",
      "print(f'accuracy brute        : {accuracy_score(${2:target}, ${1:clusters}):.3f}  (numéros arbitraires → sans valeur)')",
      "print(f'accuracy après remap  : {accuracy_score(${2:target}, labels):.3f}')",
      "display(pd.crosstab(${2:target}, labels, rownames=['réel'], colnames=['prédit']))  # matrice de confusion",
      "$0"
    ]
  }
