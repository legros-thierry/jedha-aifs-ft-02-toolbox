  "ML · Métriques de classification (fonction)": {
    "scope": "python",
    "prefix": "ml-metrics",
    "description": "compute_metrics : accuracy, precision, recall, F1, AUC (classification binaire) + dictionnaire results",
    "body": [
      "def compute_metrics(model, X, Y):",
      "    Y_pred = model.predict(X)",
      "    Y_proba = model.predict_proba(X)[:, 1]  # probabilité de la classe 1",
      "    return {",
      "        'accuracy': accuracy_score(Y, Y_pred),",
      "        'precision': precision_score(Y, Y_pred),",
      "        'recall': recall_score(Y, Y_pred),",
      "        'f1': f1_score(Y, Y_pred),",
      "        'auc': roc_auc_score(Y, Y_proba),",
      "    }",
      "",
      "",
      "results = {}",
      "results['${1:Logistic regression}'] = compute_metrics(${2:logreg}, X_test_p, Y_test)",
