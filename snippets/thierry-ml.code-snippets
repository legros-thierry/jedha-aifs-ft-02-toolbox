    "body": [
      "def ts_metrics(y_true, y_pred):",
      "    y_true, y_pred = np.array(y_true), np.array(y_pred)",
      "    return {",
      "        'MSE': mean_squared_error(y_true, y_pred),  # erreurs au carré : punit les gros écarts",
      "        'MAE': mean_absolute_error(y_true, y_pred),  # erreur moyenne, dans l'unité de y",
      "        'MAPE_%': np.mean(np.abs((y_true - y_pred) / y_true)) * 100,  # erreur moyenne en %",
      "    }",
      "",
      "",
      "# Prophet trie ses prévisions par date : le réel doit être dans le même ordre, sinon les notes sont fausses",
      "same_order = (${1:test_p}['ds'].to_numpy() == ${2:forecast}['ds'].to_numpy()).all()",
      "assert same_order, 'Réel et prévision pas alignés : trier les données par date (sort_index) et relancer'",
