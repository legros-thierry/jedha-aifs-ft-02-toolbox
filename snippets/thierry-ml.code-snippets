  "KM · Compression d'image (palette de K couleurs)": {
    "scope": "python",
    "prefix": "ml-km-image",
    "description": "Chaque pixel = une ligne (R, G, B). MiniBatchKMeans regroupe les couleurs en K clusters, chaque pixel prend la couleur de son centre. Affiche original et compressé",
    "body": [
      "from sklearn.datasets import load_sample_image",
      "",
      "image = ${1:load_sample_image('china.jpg')}  # tableau (hauteur, largeur, 3), valeurs 0 à 255",
      "print(image.shape)",
      "pixels = (image / 255).reshape(-1, 3)  # 0 à 1, puis une ligne par pixel : (n_pixels, 3)",
      "kmeans_img = MiniBatchKMeans(n_clusters=${2:16}, random_state=${3:0}, n_init='auto')  # MiniBatch : rapide sur beaucoup de lignes",
      "kmeans_img.fit(pixels)",
      "new_colors = kmeans_img.cluster_centers_[kmeans_img.predict(pixels)]  # chaque pixel → couleur de son centre",
      "image_recolored = new_colors.reshape(image.shape)  # retour à la forme de l'image",
      "",
      "_, axes = plt.subplots(1, 2, figsize=(12, 5))",
      "for ax, img, title in zip(axes, [image, image_recolored], ['Original', '${2:16} couleurs']):",
      "    ax.imshow(img)",
      "    ax.set_title(title)",
      "    ax.axis('off')",
      "plt.tight_layout()",
      "plt.show()",
      "$0"
    ]
  },

