      "categorical_features = ${1:dataset}.select_dtypes(exclude='number').columns.tolist()",
      "preprocessor = ColumnTransformer([",
      "    ('num', StandardScaler(), numeric_features),  # même échelle pour tous : sinon la grande colonne écrase les autres",
      "    ('cat', OneHotEncoder(drop='first', sparse_output=False), categorical_features),",
      "])",
      "X_p = preprocessor.fit_transform(${1:dataset})",
      "print(X_p[0:5])  # np.array → pas de .head()",
      "# ⚠️ à lancer AVANT d'ajouter la colonne Cluster_KMeans, sinon elle devient une feature",
      "$0"
    ]
  },

  "KM · Choisir K : méthode du coude (elbow)": {
    "scope": "python",
    "prefix": "ml-km-elbow",
    "description": "Boucle sur K, inertie (WCSS : somme des distances au carré entre chaque point et son centre) + courbe. On cherche le coude : là où la courbe arrête de chuter",
    "body": [
      "k_values = list(range(1, ${1:11}))",
      "wcss = []",
      "for k in k_values:",
      "    kmeans = KMeans(n_clusters=k, random_state=${2:0}, n_init='auto')",
      "    kmeans.fit(X_p)",
      "    wcss.append(kmeans.inertia_)  # inertie : baisse toujours quand K monte",
      "fig = px.line(x=k_values, y=wcss, markers=True, title='Elbow method')",
      "fig.update_layout(xaxis_title='Nombre de clusters K', yaxis_title='Inertie (WCSS)')",
      "fig.show()",
      "# Lecture : garder le K du coude (après lui, ajouter un cluster ne fait presque plus baisser l'inertie)",
      "$0"
    ]
  },

  "KM · Choisir K : score silhouette": {
    "scope": "python",
    "prefix": "ml-km-silhouette",
    "description": "Boucle sur K à partir de 2, silhouette moyenne (de -1 à 1 : proche de 1 = groupes compacts et bien séparés) + barres. On prend le K le plus haut",
    "body": [
      "k_values = list(range(2, ${1:11}))  # 2 minimum : il faut au moins deux groupes pour les comparer",
      "sil = []",
      "for k in k_values:",
      "    kmeans = KMeans(n_clusters=k, random_state=${2:0}, n_init='auto')",
      "    sil.append(silhouette_score(X_p, kmeans.fit_predict(X_p)))",
      "fig = px.bar(x=k_values, y=sil, title='Silhouette score par K')",
      "fig.update_layout(xaxis_title='Nombre de clusters K', yaxis_title='Silhouette', xaxis_type='category')",
      "fig.show()",
      "print('Meilleur K (silhouette) :', k_values[int(np.argmax(sil))])",
      "# Coude et silhouette peuvent ne pas être d'accord : trancher avec le sens métier",
      "$0"
    ]
  },

  "KM · K-means : fit + colonne cluster": {
    "scope": "python",
    "prefix": "ml-km-fit",
    "description": "KMeans avec le K retenu (init k-means++ par défaut), numéro de cluster ajouté au tableau, taille de chaque groupe",
    "body": [
